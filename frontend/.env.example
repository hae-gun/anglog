# 앵파크 realtime server. Without it, `npm run dev` uses ws://localhost:8090/ws,
# and mock mode and production builds play offline (AI birds only).
# VITE_REALTIME_URL=wss://park.example.com/ws

# API server on another origin (production: GitHub Pages screen + api server). Empty = same origin (/api via the Vite proxy).
# VITE_API_BASE=https://api.example.com
