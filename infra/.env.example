# cp .env.example .env 후 채우기 (.env는 git에 올리지 않음)
# 화면 주소 (GitHub Pages). API가 이 주소에서 오는 요청만 받는다
DOMAIN=anglog.nobody-asked.dev
# 이 서버의 주소 (API와 앵파크 실시간). 고해야지 infra/app/.env 의 ANGLOG_DOMAIN 과 같은 값
API_DOMAIN=api.anglog.nobody-asked.dev
# 긴 무작위 값: openssl rand -hex 24
DB_PASSWORD=change-me
# 앵파크 계정 확인용 서명 키 (API가 서명, 실시간 서버가 확인). 긴 무작위 값: openssl rand -hex 32
PARK_TOKEN_SECRET=change-me
# 관리자 페이지(/admin)를 열 수 있는 앵로그 아이디. 쉼표로 여러 개. 비우면 아무도 못 연다
ADMIN_HANDLES=
# 메타모아(metamoa.com) 목록. infra/scripts/metamoa.sh submit 이 신청 번호와 request_key를 여기에 적는다.
# 승인과 소유자 확인 뒤 받은 공간 키(mm_live_)와 공간 id를 넣으면 접속자 수, 소식, 이벤트가 켜진다. 비워 두면 꺼짐
METAMOA_KEY=
METAMOA_SPACE_ID=
